{
  "name": "chitbridge-mvp",
  "version": "1.0.0",
  "description": "Chit and Bridge MVP — Cross-organisation business execution platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/run-tests.js",
    "test:jest": "jest",
    "test:integration": "node tests/run-tests.js",
    "check:trips": "node tools/round-trips.cjs --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.5",
    "pg": "^8.11.3",
    "resend": "^2.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "maxWorkers": 1,
    "testTimeout": 30000,
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
