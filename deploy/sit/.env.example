# deploy/sit/.env.example - the SIT installation's settings. up.sh copies this to .env (git-ignored, mode 600) on first run, fills every
# line marked GEN with `openssl rand -hex 32`, and sets the lines marked UP from its <in|au> argument. Full contract: docs/HOSTING.md.
# NEVER commit .env. No production secret is ever copied here: every secret is generated on the VM and lives only there.
# A line starting with `#` is OPTIONAL and off; remove the `#` to turn it on (re-run ./up.sh after any change).
# Each setting is the line; the line under it says what it means.

# ---- The installation (UP = up.sh sets these from `in` or `au`) ------------------------------------------------------------
SIT_HOST=sit-in.ondcpro.com
# UP: the host people open. Caddy gets its certificate for it; *.SIT_HOST storefronts and a shop's own domain use on-demand TLS (Caddyfile)
SIT_COUNTRY=IN
# UP: ISO-2 country pack this installation STATES (installation.country, b382): registration offers it first. IN gives INR, AU gives AUD
INSTALLATION_KEY=sit-in
# UP: which `installation` row this deployment is (lib/country-setup.js). up.sh inserts the row with country, currency and timezone
WEB_ORIGIN=https://sit-in.ondcpro.com
# UP: the site as the browser sees it. Becomes api ALLOWED_ORIGINS and PUBLIC_WEB_BASE (deploy/compose.yml). Caddy serves the api on the SAME origin
CB_API_BASE=https://sit-in.ondcpro.com
# UP: the api as the browser sees it. Becomes the web's /config.js window.CB_API (Caddy also answers /config.js per host, so subdomains stay same-origin)
NODE_ENV=staging
# api: a SEALED environment (production, uat, staging, live, prod): boots only with a JWT secret and a mail posture, never honours DEV_OTP

# ---- Secrets (GEN = up.sh fills an empty value; never share, never commit) -------------------------------------------------
POSTGRES_PASSWORD=
# GEN: the database owner (migrations). The api never sees it
CB_APP_PASSWORD=
# GEN: the api's own role cb_app (NOSUPERUSER NOBYPASSRLS, so row-level security holds). The migrate job sets it
JWT_SECRET=
# GEN: api HS256 signing key, 32+ characters (a sealed environment refuses to boot below that)
# JWT_SECRET_PREV=
# api: the previous JWT_SECRET, still verified while you rotate
CB_ADMIN_KEY=
# GEN: api: enables the admin channel routes (x-cb-admin-key). Blank = up.sh generates one
VAULT_ENC_KEY=
# GEN: api: AES-256-GCM key for vault fields, 64 hex characters. Unset = vault fields are refused
CTP_PRIVATE_KEY=
# GEN: api: Ed25519 PKCS#8 PEM that signs cross-installation (CTP) envelopes, on ONE line with newlines written as backslash-n. up.sh makes it on first run (openssl genpkey -algorithm ed25519) and publishes the public half at /.well-known/ctp.json; unset = the installation cannot sign
# SIT_PEERS=
# up.sh: the other installations this one trades with over CTP, as <installation_key>=<host>[,...], e.g. on sit-in: sit-au=129-225-90-80.sslip.io. Each becomes a REMOTE installation row (hosted_locally=false, domain, endpoint https://<host>/api/ctp/deliver); the peer's public key is read from its own manifest, never stored. Set on BOTH sides

# ---- Sign-in tonight: the daily tester code (TEMPORARY, lib/dev-otp.js; remove both lines before real users) ----------------
TESTER_CODE=
# GEN: up.sh writes <8 random hex>{yymmdd}. The api fills {yymmdd} with TODAY (in TESTER_CODE_TZ) and also takes yesterday's until 06:00.
# Testers type <the fixed part><today's yymmdd>, e.g. 3fa91c07261024. The fixed part is the secret: share it privately, change it any time
TESTER_NAMES=*@test.chitbridge,qa-*
# api: who may use the tester code: sign-in names or `*` patterns. EMPTY = nobody. A bare `*` is refused outside a local stack
TESTER_CODE_TZ=Asia/Kolkata
# UP: the zone whose day fills {yymmdd}: Asia/Kolkata for in, Australia/Sydney for au
# TESTER_GUESS_MAX=
# api: wrong tester-code guesses per account per window before the tester door shuts for that account (default in lib/dev-otp.js)

# ---- Sign-in later: the e-mailed code ---------------------------------------------------------------------------------------
OTP_EMAIL_ENABLED=true
# api: must be true in a sealed environment (deploy/compose.yml pins it). With the placeholder key below no mail leaves; the tester code still works
RESEND_API_KEY=re_sit_placeholder_no_mail_is_sent
# api: Resend key for EVERY outgoing e-mail. The placeholder satisfies the sealed boot check. Real one: re_... from resend.com. The api has NO SMTP code
FROM_EMAIL=noreply@ondcpro.com
# api: sender of every e-mail. The domain must be verified at the mail provider before real codes go out
# RESEND_BASE_URL=
# the Resend SDK's endpoint: point it at any Resend-compatible relay you run. The only route to SMTP today (docs/HOSTING.md, mail)
# LEADS_EMAIL=
# api: where simulator leads are mailed (default FROM_EMAIL)
# SIM_JWT_SECRET=
# api: signs simulator lead links (default derives from JWT_SECRET)
# MAX_OTP_ATTEMPTS=5
# api: wrong-code tries before an OTP dies
# EMAIL_INBOUND_SECRET=
# api: HMAC for the inbound e-mail webhook; unset = inert

# ---- up.sh and ask.cjs only (the api does not read these) -------------------------------------------------------------------
# GIT_TOKEN=
# up.sh: a read-only GitHub token (fine-grained, contents:read) while the two repos are private. Used for clone and pull, never stored in a remote URL
# API_REF=main
# up.sh: the api branch to run (until the PR lands: plat/sit-deploy-kit)
# WEB_REF=main
# up.sh: the web branch to run
# SIT_ROOT=
# up.sh: where the two repos live (default ~/sit: chitbridge-api and chitbridge-web side by side; deploy/compose.yml expects the web at ../../chitbridge-web)
# ASK_CUSTOM_HOSTS=
# ask.cjs: comma list of a shop's OWN domains (CNAME to SIT_HOST) you approve for a certificate by hand. No table behind it yet (CLOUD-DEPENDENCY.md)

# ---- api: server and public addresses --------------------------------------------------------------------------------------
# PORT=3000
# api listen port (nothing is published; Caddy reaches api:3000)
# HOST=
# api listen address; unset = all interfaces inside the container
PUBLIC_API_BASE=https://sit-in.ondcpro.com
# UP: public api URL for OpenAPI, connector downloads and IoT provisioning. deploy/sit/docker-compose.yml sets it from SIT_HOST
# PUBLIC_API_URL=
# api: public api URL for product media links
# CB_SELF_URL=
# api: how auto-raise calls this api (default loopback)
# ALLOWED_ORIGINS=
# api CORS allowlist; compose sets it from WEB_ORIGIN. Caddy removes Origin on /api, so subdomains need no entry
# PLATFORM_ROOT_HANDLE=
# api: reserves the operator's handle from sign-up
# PLATFORM_ROOT_ENTITY=
# api: operator entity uuid; unset = no operator surface
# PLATFORM_ROOT_ENTITY_TEST=
# api: operator root for the test population
# PLATFORM_ROOT_ENTITY_SANDBOX=
# api: operator root for the sandbox population
# NETWORK_WRITE_ENABLED=true
# api: false makes /api/network read-only
# LEGACY_TOKEN_REFUSE=1
# api: refuse tokens with no jti (K-SEC). A fresh install has none, so it is safe to turn on
# JWT_TTL=7d
# api: lifetime of simulator lead tokens

# ---- api: database (compose builds DATABASE_URL itself; set these only to tune) ---------------------------------------------
# DB_POOLER_URL=
# api: a second DSN tried only when DATABASE_URL fails; not used on this stack
# PGSSLMODE=
# api: TLS when the URL says nothing (the compose DSN says sslmode=disable; Postgres is on the private Docker network)
# DB_BOOT_WAIT_MS=15000
# api: how long a request waits for the pool at boot
# DB_STATEMENT_TIMEOUT_MS=15000
# api: per-statement deadline, 0 = off
# DB_SLOW_MS=500
# api: log statements slower than this
# DB_QUERY_LOG=true
# api: log every query fingerprint (debug)
# RLS_GUARD=warn
# api: a tenant query with no context: off, warn or throw
# DB_PORT=5432
# compose only: the db's loopback port number (SIT publishes none; harmless to leave)

# ---- api: object store (unset = attachments live in the database) -----------------------------------------------------------
# STORAGE_ADAPTER=db
# api: `object` sends attachments to the store below
# S3_ENDPOINT=
# api: any S3-compatible store (Oracle Object Storage's S3 endpoint, MinIO, R2, AWS)
# S3_ACCESS_KEY_ID=
# api: S3 access key (SigV4)
# S3_SECRET_ACCESS_KEY=
# api: S3 secret key (SigV4); never sent
# S3_BUCKET=cb-attach
# api: bucket (private)
# S3_REGION=us-east-1
# api: SigV4 region (Oracle: its region id, e.g. ap-mumbai-1)
# S3_PATH_STYLE=true
# api: false = <bucket>.<host> addressing
# S3_KEY=
# api: Supabase Storage REST bearer key. Only for the Supabase transport; not for SIT

# ---- api: limits and tuning ---------------------------------------------------------------------------------------------------
# RATE_LIMIT_MAX=500
# api: general /api requests per window per client (Caddy passes the real client IP in X-Forwarded-For; trust proxy is 1)
# AUTH_RATE_LIMIT_MAX=30
# api: sign-in attempts per window
# CHECK_LOGIN_RATE_LIMIT_MAX=120
# api: login-check calls per window
# CATALOGUE_RATE_LIMIT_MAX=60
# api: public catalogue reads per window (ask.cjs reads one shop per new subdomain; it caches and caps itself at 30 a minute)
# ASSIST_RATE_LIMIT_MAX=40
# api: assistant calls per window
# BODY_LIMIT_DEFAULT=256kb
# api: request body cap
# BODY_LIMIT_LARGE=8mb
# api: body cap on the large routes
# REQUEST_TIMEOUT_MS=30000
# api: request deadline
# IDEMPOTENCY_WINDOW_HOURS=48
# api: how long an idempotency key is remembered
# IDEMPOTENCY_TOKEN_MINUTES=
# api: life of an idempotency token
# IDEMPOTENCY_STALE_MINUTES=
# api: age after which an unfinished idempotent call may be retried
# IMPORT_PREFLIGHT_MAX=60
# api: product-import preflights per window
# IMPORT_COMMIT_MAX=20
# api: product-import commits per window
# PRODUCTS_BULK_MAX=60
# api: bulk product writes per window
# TILL_CATALOGUE_MAX=20
# api: counter catalogue reads per window
# TILL_DELTA_CAP=20000
# api: counter delta size cap
# NOTIF_FEED_DAYS=90
# api: notification feed look-back
# WORKPATTERN_MEMO_TTL_MS=300000
# api: work-pattern cache life
# CB_DISPUTE_WIDEN_CATEGORIES=
# api: dispute categories whose audience is widened (comma list)
# RETENTION_GRACE_DAYS=30
# api: retention grace window
# RETENTION_SOFT_DELETE_DAYS=7
# api: soft-delete window
# RETENTION_MAX_EXTEND_DAYS=365
# api: longest extension of a retention hold
# RETENTION_MAX_ROWS_PER_RUN=1000
# api: runaway guard, rows per sweep
# RETENTION_MAX_PCT_PER_RUN=20
# api: runaway guard, percent of a table per sweep
# LOG_LEVEL=info
# api: minimum log level
# CB_TRIPS=1
# api: count DB round trips per request (shown in the log)
# CB_ALERT_WEBHOOK=
# api: a URL that receives each CRITICAL log line (a Slack, Teams or ntfy webhook)
# BOOKS_NIGHTLY=0
# api: 0 stops the 6-hourly books check
# CRM_SWEEP=0
# api: 0 stops the 6-hourly follow-up sweep
# OUTPUT_ALLOWLIST=
# api: `enforce` cuts response fields to the contract (the test harness uses it)
# PRIVACY_CONTACT=
# api: the privacy contact named in the consent notice
# PRIVACY_NOTICE_VERSION=
# api: the notice version stamped on each consent row
# TEST_BOARD_WRITERS=
# api: who may write the test board (comma list of sign-in names)
# CB_CTP_ALLOW_PRIVATE=
# api: 1 lets CTP fetch a peer on a private address. Needed only if the two SIT hosts peer over a private network
# SHOP_CLOCK_ALLOW=
# api: 1 lets a shop's clock be moved (TEST ONLY, leave off)
# BOOKS_DEV_ENGINES=
# api: 1 loads books engines from a dev checkout (never on a server)
# SOURCE_COMMIT=
# api: commit shown on /health. up.sh sets it from git on every run

# ---- api: channels (all optional; each is inert until its key is set) --------------------------------------------------------
# WHATSAPP_TOKEN=
# Meta access token: WhatsApp replies and media fetch
# WHATSAPP_APP_SECRET=
# Meta app secret: verifies inbound webhooks
# WHATSAPP_VERIFY_TOKEN=
# answers Meta's webhook handshake
# WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v21.0
# Graph API base
# WHATSAPP_MEDIA_MAX_BYTES=5000000
# largest inbound media fetched
# SMS_PROVIDER=
# SMS OTP provider name (adapter not built: a stub)
# SMS_API_KEY=
# SMS provider key (stub)
# SMS_SENDER_ID=CHITBR
# SMS sender id (stub)
# SMS_INBOUND_SECRET=
# presence marks the SMS channel configured

# ---- api: AI (all optional; unset = the feature is off) ----------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# enables the AI engine (lib/ai.js)
# AI_MODEL=claude-haiku-4-5-20251001
# model for the AI engine
# AI_PRICE_IN=1
# USD per million input tokens, for metering
# AI_PRICE_OUT=5
# USD per million output tokens, for metering
# AI_MAX_TOKENS=4000
# max output tokens per call
# AI_MAX_IMAGES=4
# images per call
# AI_MAX_IMAGE_B64=1400000
# image size cap per call
# AI_FREE_USD=1.0
# free AI allowance per entity
# AI_RATE_PER_HOUR=60
# per-entity AI calls per hour
# AI_RATE_PER_DAY=300
# per-entity AI calls per day
# AI_GATE=on
# `off` disables the AI spend gate
# AI_GLOBAL_DAILY_USD=25
# platform-wide daily AI spend ceiling
# AI_METER_FAIL_MAX=20
# tolerated metering failures before refusing
# AI_SKILL_TTL_MS=60000
# cache life of AI skill rows
# ASSIST_LLM_PROVIDER=anthropic
# assistant provider (only anthropic is wired)
# ASSIST_LLM_API_KEY=
# assistant provider key
# ASSIST_LLM_MODEL=claude-haiku-4-5-20251001
# assistant model
# OPENAI_API_KEY=
# speech-to-text via OpenAI; also flags forms AI available
# SPEECH_PROVIDER=openai
# speech engine
# SPEECH_MODEL=whisper-1
# speech model
# SPEECH_TIMEOUT_MS=20000
# speech request timeout
# WHISPER_URL=
# a self-hosted whisper server; unset = audio kept, not sent
# FORMS_AI_PROVIDER=
# marks AI form-fill available
# FORMS_ERP_PROVIDER=
# marks the ERP form source available (inert)
# FORMS_ERP_KEY=
# ERP form source key (inert)
# FORMS_IOT_PROVIDER=
# marks the IoT form source available (inert)
# FORMS_IOT_KEY=
# IoT form source key (inert)
# FORMS_REGISTRY=
# JSON that overrides the forms registry

# ---- api: KYB / verification (India: sandbox.co.in GST, PAN, IEC) -----------------------------------------------------------
# SANDBOX_API_KEY=
# Sandbox.co.in key
# SANDBOX_API_SECRET=
# Sandbox.co.in secret
# SANDBOX_BASE=https://api.sandbox.co.in
# Sandbox API base
# SANDBOX_API_VERSION=1.0
# Sandbox API version header
# SANDBOX_AUTH_VERSION=1.0.0
# Sandbox auth version header
# SANDBOX_GST_PATH=/gst/compliance/public/gstin/search
# Sandbox GST endpoint path
# SANDBOX_PAN_PATH=
# Sandbox PAN endpoint path
# SANDBOX_IEC_PATH=
# Sandbox IEC endpoint path
# CB_KYB_PROVIDER=sandbox
# KYB verifier: sandbox or generic
# CB_KYB_BASE=
# generic KYB provider endpoint
# CB_KYB_KEY=
# generic KYB provider bearer key
# KYB_FIELD_PROVIDER=
# market-demand provider (adapter not built)
# KYB_FIELD_KEY=
# market-demand provider key
# KYB_FIELD_COST_USD=0.02
# metered cost per field lookup
# KYB_FIELD_CACHE_HOURS=24
# field lookup cache life
# KYB_EXPIRY_WINDOW_DAYS=60
# warn this many days before a document expires
# KYB_CONCENTRATION_PCT=40
# buyer-concentration warning threshold
# KYB_STRUCTURAL=
# JSON that overrides the structural KYB rules

# ---- web (chitbridge-web's Dockerfile reads ONE variable) --------------------------------------------------------------------
# CB_API_BASE is set above. Nothing else: the site is static and no secret lives in it. up.sh sets CB_WEB_DIR (compose) to the web checkout.

# ---- Deliberately NOT on this file (docs/HOSTING.md lists them) ---------------------------------------------------------------
# DEV_OTP, DEV_OTP_CUSTOMER, DEV_OTP_CONNECTOR, DEV_OTP_IN_RESPONSE: fixed codes work on a local stack only; a sealed environment refuses to boot with DEV_OTP set
# PUBLIC_WEB_BASE: compose sets it from WEB_ORIGIN.   API_PORT, WEB_PORT: loopback ports of the base compose; the SIT override publishes none
# RAILWAY_GIT_COMMIT_SHA, RAILWAY_REGION, RAILWAY_REPLICA_REGION: set by Railway only. SOURCE_COMMIT is the neutral name (up.sh sets it)
# SUPABASE_REF, DB_POOLER_FALLBACK, PGSSL: Supabase-era switches; SIT uses a plain DATABASE_URL with sslmode=disable on the private Docker network
# CB_SPIN_ID, CB_SPIN_COUNTRY, CTP_PEER_API, SIM_YEARS, MAIL_SINK_TOKEN: the cloud spin test scripts only
