# deploy/env.example — copy to deploy/.env (git-ignored) and fill. The full contract: docs/HOSTING.md.
# ⚠️ Never commit deploy/.env. Every value below marked SECRET is one.

# the database the stack starts (SECRET)
POSTGRES_PASSWORD=<a long random password>
# the api's own database role (cb_app: row-level security holds) — the migrate job sets this password (SECRET)
CB_APP_PASSWORD=<another long random password>
# the api's signing secret, 32+ characters (SECRET)
JWT_SECRET=<64 random characters>

# sign-in codes are e-mailed in production (lib/dev-otp.js): a Resend key and a sender (SECRET: the key)
RESEND_API_KEY=<re_… from resend.com>
FROM_EMAIL=noreply@your-domain.example

# where people open the site, and where the site finds the api (as the BROWSER sees them)
WEB_ORIGIN=http://localhost:8080
CB_API_BASE=http://localhost:3000

# optional object store (unset = kept in the database) — any S3-compatible store, SigV4 (docs/HOSTING.md, Storage). With
# `--profile minio` the stack runs MinIO and these two are its root login (SECRET: the secret key)
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=cb-attach
# STORAGE_ADAPTER=object
