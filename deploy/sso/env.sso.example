# deploy/sso/env.sso.example - SEC-112 P0: the NAMES of every variable provider sign-in reads. NO VALUE IS WRITTEN HERE; the box env file (deploy/sso/.sso.env, mode 600, owner only) is made by sso-box-setup.sh.
# Never commit a value. A provider exists on an installation only when its key is in SIGNIN_PROVIDERS AND its client id, client secret and PUBLIC_API_BASE (and PUBLIC_WEB_BASE) are set.
SIGNIN_PROVIDERS=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
# the one public address of the api (redirects are built from it ONLY, never from the Host header) and of the web page the person returns to
PUBLIC_API_BASE=
PUBLIC_WEB_BASE=
# the stand-in (a test issuer: oauth2-mock-server in CI, Keycloak on a SIT box). Works ONLY with an explicit non-sealed NODE_ENV. Never in production.
SIGNIN_STANDIN=
SIGNIN_STANDIN_GOOGLE_ISSUER=
SIGNIN_STANDIN_MICROSOFT_ISSUER=
# port mode only (a shared box): loopback ports of this run
SSO_KC_PORT=
SSO_API_PORT=
