{
 "_selftest": [
  {
   "name": "the same shape conforms",
   "example": {
    "a": 1,
    "b": "x",
    "c": true,
    "l": [
     {
      "k": 1
     }
    ]
   },
   "actual": {
    "a": 7,
    "b": "y",
    "c": false,
    "l": [
     {
      "k": 2
     },
     {
      "k": 3
     }
    ]
   },
   "conforms": true
  },
  {
   "name": "a key the contract does not list is a failure",
   "example": {
    "a": 1
   },
   "actual": {
    "a": 1,
    "z": 2
   },
   "conforms": false
  },
  {
   "name": "a key the contract lists and the answer lacks is a failure",
   "example": {
    "a": 1,
    "b": 2
   },
   "actual": {
    "a": 1
   },
   "conforms": false
  },
  {
   "name": "...unless that path is optional",
   "example": {
    "a": 1,
    "b": 2
   },
   "actual": {
    "a": 1
   },
   "optional": [
    "b"
   ],
   "conforms": true
  },
  {
   "name": "a list where an object is expected fails (the roles bug)",
   "example": {
    "roles": {
     "customer": true,
     "supplier": false
    }
   },
   "actual": {
    "roles": [
     "customer"
    ]
   },
   "conforms": false
  },
  {
   "name": "an object where a list is expected fails",
   "example": {
    "rows": [
     {
      "a": 1
     }
    ]
   },
   "actual": {
    "rows": {
     "a": 1
    }
   },
   "conforms": false
  },
  {
   "name": "a number where a string is expected fails",
   "example": {
    "a": "x"
   },
   "actual": {
    "a": 5
   },
   "conforms": false
  },
  {
   "name": "an empty answer list conforms",
   "example": {
    "rows": [
     {
      "a": 1
     }
    ]
   },
   "actual": {
    "rows": []
   },
   "conforms": true
  },
  {
   "name": "a null in the answer fits anything",
   "example": {
    "a": 1,
    "o": {
     "b": 1
    }
   },
   "actual": {
    "a": null,
    "o": null
   },
   "conforms": true
  },
  {
   "name": "a null in the contract accepts anything",
   "example": {
    "a": null
   },
   "actual": {
    "a": {
     "deep": [
      1
     ]
    }
   },
   "conforms": true
  },
  {
   "name": "a list of different kinds: an element may be any one of them",
   "example": {
    "e": [
     {
      "k": "a",
      "x": 1
     },
     {
      "k": "b",
      "y": 2
     }
    ]
   },
   "actual": {
    "e": [
     {
      "k": "a",
      "x": 5
     },
     {
      "k": "b",
      "y": 6
     }
    ]
   },
   "conforms": true
  },
  {
   "name": "...but not a mixture of two",
   "example": {
    "e": [
     {
      "k": "a",
      "x": 1
     },
     {
      "k": "b",
      "y": 2
     }
    ]
   },
   "actual": {
    "e": [
     {
      "k": "a",
      "x": 5,
      "y": 5
     }
    ]
   },
   "conforms": false
  },
  {
   "name": "an optional path inside a list is written list[].key",
   "example": {
    "l": [
     {
      "a": 1,
      "o": {
       "c": 1
      }
     }
    ]
   },
   "actual": {
    "l": [
     {
      "a": 1,
      "o": {}
     }
    ]
   },
   "optional": [
    "l[].o.c"
   ],
   "conforms": true
  },
  {
   "name": "a list of lists is checked inside",
   "example": {
    "m": [
     [
      1
     ]
    ]
   },
   "actual": {
    "m": [
     [
      "x"
     ]
    ]
   },
   "conforms": false
  }
 ],
