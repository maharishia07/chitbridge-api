# Chit and Bridge MVP — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string from Supabase
# Settings → Database → Connection String (URI format)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# ── Authentication ────────────────────────────────────────────
# JWT secret — minimum 32 characters — generate a random string
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-minimum-32-character-random-secret-string

# ── Email OTP ─────────────────────────────────────────────────
# Resend API key for OTP emails — resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email sender address — must be verified domain in Resend
FROM_EMAIL=noreply@chitandbridge.com

# ── CORS ──────────────────────────────────────────────────────
# Your Vercel URL after deploying React frontend
# Example: https://chitbridge-web.vercel.app
ALLOWED_ORIGIN=https://your-vercel-url.vercel.app

# ── OTP Delivery ──────────────────────────────────────────────
# Controls how OTP is delivered
# false (default) — OTP logged to console — use for dev and SIT
# true            — OTP sent via email    — use for UAT and production
OTP_EMAIL_ENABLED=false

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Change to production when deploying to Railway

# ── AI Assistant (optional) ───────────────────────────────────
# Turns the in-app assistant from its free, deterministic "library floor" into a
# real model call (Claude) grounded on lib/assist-kb.js. Leave BOTH blank/unset and
# the assistant simply runs on the library floor — no cost, no behaviour change.
#
# To activate (set on the LIVE API env, e.g. Railway — never commit the real key):
#   1. ASSIST_LLM_PROVIDER=anthropic   (must be exactly "anthropic")
#   2. ASSIST_LLM_API_KEY=<your Anthropic API key>
#   3. (optional) ASSIST_LLM_MODEL — defaults to claude-haiku-4-5-20251001
#   4. Restart the API. Requires @anthropic-ai/sdk (already a dependency) and an
#      intact lib/assist-kb.js (the grounding KB — do NOT ship it deleted).
# The gate needs BOTH provider AND key; the key alone won't switch it on. On any
# model error the client still falls back to the library floor.
ASSIST_LLM_PROVIDER=
ASSIST_LLM_API_KEY=
ASSIST_LLM_MODEL=

# ── VAULT AT-REST ENCRYPTION (reviewer F1) — REQUIRED before storing real vault (banking/tax) data ──
# 32-byte key as base64 or hex; lives ONLY here/in the host env, NEVER in the DB. Without it, the vault refuses to save
# (fail closed) so real data can't land in plaintext. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENC_KEY=

# ── AI wallet-gate tunables (reviewer F4) ──
# AI_GLOBAL_DAILY_USD — platform-wide daily AI spend ceiling across ALL entities (default 25)
# AI_METER_FAIL_MAX   — consecutive metering failures before the gate fails closed (default 20)
# AI_FREE_USD / AI_RATE_PER_HOUR / AI_RATE_PER_DAY — per-entity free allowance + rate caps (defaults 1.0 / 60 / 300)
AI_GLOBAL_DAILY_USD=
AI_METER_FAIL_MAX=
